# .env.nginx-example — copy to .env.nginx and fill in your values
#
# IMPORTANT: Never commit .env.nginx to version control.
# The .gitignore in this repository should already exclude it.

# Shared secret for Nginx secure_link tokens (download URLs).
# Must match LocalNginxAssetRepositoryConfig(secure_link_secret=...).
# Use a long random string in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURE_LINK_SECRET=change-me-before-use

# HMAC-SHA256 secret for upload tokens embedded in tus Upload-Metadata.
# Must match LocalNginxAssetRepositoryConfig(upload_secret=...) and the
# secret used by your tusd hook endpoint to validate incoming uploads.
# Use a different value from SECURE_LINK_SECRET.
UPLOAD_SECRET=change-me-before-use
