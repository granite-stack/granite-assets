# .env.nginx-example — copy to .env.nginx and fill in your values
#
# IMPORTANT: Never commit .env.nginx to version control.
# The .gitignore in this repository should already exclude it.

# Shared secret for Nginx secure_link tokens.
# Must match the value in LocalNginxAssetRepositoryConfig(secure_link_secret=...).
# Use a long random string in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURE_LINK_SECRET=9cGWrI7mDAJop9qQSDiBIS4EjCNZRGoE3ZhWJMv9pyU
